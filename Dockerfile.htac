# Python service + web console. The Ansible Dockerfile is left in place so the
# old flow still runs during migration.

# --- stage 1: build the SPA -------------------------------------------------
FROM node:22-slim AS web

WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN npm ci --silent
COPY web/ ./
RUN npm run build

# --- stage 2: runtime -------------------------------------------------------
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_NO_COMPILE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /srv

# Dependencies are pinned in pyproject.toml so image builds are reproducible --
# the Ansible image installed ansible/certbot unpinned on every build.
COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir . && \
    # Nothing installs packages at runtime, so the installer is dead weight.
    pip uninstall -y pip setuptools wheel 2>/dev/null || true && \
    find /usr/local/lib/python3.12 -name '__pycache__' -type d -prune -exec rm -rf {} + && \
    find /usr/local/lib/python3.12 -name '*.pyc' -delete && \
    useradd --create-home --uid 10001 htac && \
    mkdir -p /srv/data && chown -R htac:htac /srv

COPY --from=web /build/dist ./web/dist

# Runs unprivileged; the Ansible image ran everything as root.
USER htac

VOLUME ["/srv/data"]
EXPOSE 8000

# Default to the web console + scheduler. Override with `htac <command>` for CLI use.
ENTRYPOINT ["python", "-m", "uvicorn"]
# --proxy-headers: behind a tunnel or reverse proxy, trust X-Forwarded-* so
# client addresses in the logs are real rather than the proxy's.
CMD ["app.api.app:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
