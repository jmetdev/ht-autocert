# Production image for the API, scheduler, CLI and web console.

# --- stage 1: build the SPA -------------------------------------------------
FROM node:22-slim AS web

WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN npm ci --silent
COPY web/ ./
RUN npm run build

# --- stage 2: Python dependencies -------------------------------------------
FROM python:3.12-slim AS python-base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_NO_COMPILE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /srv

COPY pyproject.toml ./
COPY app ./app
RUN pip install --no-cache-dir .

# --- stage 3: test ----------------------------------------------------------
FROM python-base AS test

RUN pip install --no-cache-dir '.[dev]'
COPY tests ./tests
ENTRYPOINT ["python", "-m", "pytest"]
CMD ["-q"]

# --- stage 4: runtime ---------------------------------------------------------
FROM python-base AS runtime

ARG APP_VERSION=2.0.0
LABEL org.opencontainers.image.title="ht-autocert" \
      org.opencontainers.image.description="Certificate automation for Cisco IOS-XE gateways" \
      org.opencontainers.image.version="$APP_VERSION"

RUN pip uninstall -y pip setuptools wheel 2>/dev/null || true && \
    find /usr/local/lib/python3.12 -name '__pycache__' -type d -prune -exec rm -rf {} + && \
    find /usr/local/lib/python3.12 -name '*.pyc' -delete && \
    useradd --create-home --uid 10001 htac && \
    mkdir -p /srv/data && chown -R htac:htac /srv

COPY --from=web /build/dist ./web/dist

# Runs unprivileged; the Ansible image ran everything as root.
USER htac

VOLUME ["/srv/data"]
EXPOSE 8000

# Default to the web console + scheduler. Override with `htac <command>` for CLI use.
ENTRYPOINT ["python", "-m", "uvicorn"]
# --proxy-headers: behind a tunnel or reverse proxy, trust X-Forwarded-* so
# client addresses in the logs are real rather than the proxy's.
CMD ["app.api.app:app", "--host", "0.0.0.0", "--port", "8000", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
