#!/usr/bin/env bash
# Run the htac CLI inside the Docker container.
set -euo pipefail
cd "$(dirname "$0")"

# shellcheck source=scripts/compose.sh
source scripts/compose.sh

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

command -v docker >/dev/null || die "Docker is not installed"
docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is not installed"

tty_flags=()
if [ -t 0 ] && [ -t 1 ]; then
  tty_flags=(-t)
fi

# -t is a compose exec/run flag and must sit before the service name.
# Appending it after "$@" made an interactive shell fail with
# "No such option: -t" on every htac command.
run_cli() {
  local subcmd="$1"
  shift
  if ((${#tty_flags[@]})); then
    htac_compose "$subcmd" "${tty_flags[@]}" "$@"
  else
    htac_compose "$subcmd" "$@"
  fi
}

container_id="$(htac_compose ps -q htac 2>/dev/null || true)"
if [[ -n "$container_id" ]] && docker inspect --format '{{.State.Running}}' "$container_id" 2>/dev/null | grep -q true; then
  run_cli exec htac htac "$@"
else
  run_cli run --rm --build --entrypoint htac htac "$@"
fi
