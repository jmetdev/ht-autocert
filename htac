#!/usr/bin/env bash
# Wrapper so you can run ./htac without activating the virtualenv.
#
# The `htac` command itself is a console script generated by
# `pip install -e .` (see [project.scripts] in pyproject.toml). It lives in
# .venv/bin/, not in this directory, so this shim finds it for you.
set -euo pipefail
cd "$(dirname "$0")"

VENV_PY=".venv/bin/python"

if [ ! -x "$VENV_PY" ]; then
  cat >&2 <<'EOF'
ERROR: no virtualenv found at ./.venv

Set it up first:

  python3 -m venv .venv
  .venv/bin/pip install -e '.[dev]'

Then run ./htac again.
EOF
  exit 1
fi

if ! "$VENV_PY" -c "import app" 2>/dev/null; then
  echo "ERROR: the 'app' package is not installed in ./.venv" >&2
  echo "Run: .venv/bin/pip install -e '.[dev]'" >&2
  exit 1
fi

# Load .env.htac if present, so HTAC_* settings do not have to be exported by hand.
if [ -f .env.htac ]; then
  set -a
  # shellcheck disable=SC1091
  source .env.htac
  set +a
fi

# Prefer the generated console script so --help shows the right program name.
if [ -x ".venv/bin/htac" ]; then
  exec ".venv/bin/htac" "$@"
fi
exec "$VENV_PY" -m app.cli "$@"
