# ht-autocert service configuration.

# --- Required ---------------------------------------------------------------

# Wraps every escrowed private key in the database. Generate once with:
#   htac gen-master-key
# Store it in a secrets manager. If this key is lost, every escrowed private
# key becomes unrecoverable.
HTAC_MASTER_KEY=

# Cloudflare token, scoped Zone:DNS:Edit on the single managed zone.

HTAC_CLOUDFLARE_API_TOKEN=

# --- Optional ---------------------------------------------------------------

HTAC_CLOUDFLARE_ZONE=managedcollab.com
# SQLite datastore path. Docker Compose always sets this to the htac-data volume.
HTAC_DATABASE_URL=sqlite:////srv/data/htac.db

# DNS-01: the zone's authoritative nameservers are polled until the TXT record
# is visible, rather than sleeping a fixed interval and hoping.
HTAC_DNS_PROPAGATION_TIMEOUT=300
HTAC_DNS_POLL_INTERVAL=5
HTAC_ACME_ORDER_TIMEOUT=300

HTAC_LOG_LEVEL=info
HTAC_LOG_JSON=false

# In Docker, prefer the *_FILE variants pointing at mounted secrets:
#   HTAC_MASTER_KEY_FILE=/run/secrets/htac_master_key
#   HTAC_CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cloudflare_api_token

# --- Web console / API ------------------------------------------------------

# Bearer token for the API and console. The API fails closed without it.
# Generate with: openssl rand -base64 32
HTAC_API_TOKEN=

# Scheduler: daily, not monthly. A monthly cron against a 30-day threshold can
# leave a single day of margin on a 90-day certificate.
HTAC_SCHEDULE_ENABLED=true
HTAC_SCHEDULE_TIME=02:00
HTAC_SCHEDULE_DEPLOY=true

# Stable per-device offset added to the renewal threshold so gateways
# provisioned together do not renew together. See README-python.md.
HTAC_RENEWAL_SPREAD_DAYS=21

# Only needed if the console is served from a different origin than the API.
HTAC_API_CORS_ORIGINS=

# --- Webex OAuth sign-in (optional; the API token keeps working alongside) ---
# Create an integration at https://developer.webex.com/my-apps
#   Redirect URI: must match HTAC_WEBEX_REDIRECT_URI exactly
#   Scopes:       register the integration with every scope you intend to
#                 request -- Webex rejects the whole authorization otherwise.
HTAC_WEBEX_SCOPES=spark:people_read,spark-admin:organizations_read,spark-admin:telephony_config_read
HTAC_WEBEX_CLIENT_ID=
HTAC_WEBEX_CLIENT_SECRET=
HTAC_WEBEX_REDIRECT_URI=https://autocert.managedcollab.com/auth/callback

# Who may actually sign in. Authentication proves identity; these decide access.
# With none of them set, EVERY Webex login is denied -- any Webex user on earth
# can authenticate against a public integration.
HTAC_WEBEX_ALLOWED_DOMAINS=hyetechnetworks.com
HTAC_WEBEX_ALLOWED_EMAILS=
HTAC_WEBEX_ALLOWED_ORG_ID=

HTAC_SESSION_TTL_HOURS=12
# Only set false when testing over plain HTTP.
HTAC_SESSION_COOKIE_SECURE=true

# --- Connectivity to on-prem gateways ---------------------------------------
# Twingate overlay (docker-compose.twingate.yml)
TWINGATE_NETWORK=
# Cloudflare overlay (docker-compose.cloudflared.yml)
CF_GATEWAY_HOSTNAME=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Role for a signed-in user with no explicit grant. "none" denies -- signing in
# is not the same as being an operator. Grants: ./htac operator add <email>
HTAC_WEBEX_DEFAULT_ROLE=none
# Always-admin addresses, so a fresh deployment is reachable before any grant
# exists. Keep this short; remove once real grants are in place.
HTAC_BOOTSTRAP_ADMINS=jmetcalf@hyetechnetworks.com

# Shared PKCS12 password. Used for every issued bundle so a failed router
# import can be retried with the same .p12 file. Alphanumeric only.
HTAC_PKCS12_PASSWORD=HtAcPkcs12

# URL the *gateways* use to fetch a staged PKCS12 (copy http://... flash:).
# This is often the console's public origin, e.g. https://autocert.example.com
HTAC_PUBLIC_BASE_URL=

# --- Publishing --------------------------------------------------------------
# Public DNS name used by the VPS Caddy overlay. Point its A/AAAA record at
# the VPS before running scripts/vps-deploy.sh.
HTAC_DOMAIN=autocert.example.com
# Host port the container publishes on. TLS terminates at the tunnel/proxy.
HTAC_HOST_PORT=8866
# Bind address. Keep 127.0.0.1 when a tunnel or proxy on this host forwards to
# it; 0.0.0.0 exposes the console to the network and needs TLS in front.
HTAC_BIND=127.0.0.1

# Image GitHub Actions publishes to GHCR. Leave unset for local `up --build`.
# HTAC_IMAGE=ghcr.io/jmetdev/ht-autocert:latest
